{
  "name": "@cryptonly/x402",
  "version": "0.1.0",
  "description": "Cryptonly facilitator client for the x402 payment protocol.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptonly-net/x402.git"
  },
  "homepage": "https://github.com/cryptonly-net/x402#readme",
  "bugs": {
    "url": "https://github.com/cryptonly-net/x402/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@x402/core": "^2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@x402/core": "^2.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.3"
  }
}
