{
  "name": "@cryptonly/x402",
  "version": "0.4.0",
  "description": "Cryptonly facilitator client and dashboard-configured payment middleware for the x402 protocol.",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptonly-net/x402.git",
    "directory": "typescript"
  },
  "homepage": "https://github.com/cryptonly-net/x402#readme",
  "bugs": {
    "url": "https://github.com/cryptonly-net/x402/issues"
  },
  "keywords": [
    "cryptonly",
    "x402",
    "facilitator",
    "payments",
    "client",
    "typescript",
    "express",
    "middleware"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.js",
      "default": "./dist/express.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "express": [
        "./dist/express.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@x402/core": "^2",
    "@x402/evm": "^2",
    "@x402/express": "^2",
    "@x402/extensions": "^2",
    "@x402/svm": "^2",
    "express": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "@x402/evm": {
      "optional": true
    },
    "@x402/express": {
      "optional": true
    },
    "@x402/extensions": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@x402/svm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/express": "^2.28.0",
    "@x402/extensions": "^2.28.0",
    "@x402/svm": "^2.28.0",
    "express": "^5.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.9.3"
  }
}
